{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smeltery/bellows/blob/main/docs/schemas/verification-receipt.schema.json",
  "title": "Bellows verification receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "run_id",
    "started_at",
    "completed_at",
    "identity",
    "input",
    "checks",
    "results"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "completed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "input": {
      "enum": [
        "ready",
        "dirty",
        "conflict",
        "stale",
        "error"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    }
  },
  "$defs": {
    "fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow",
        "config",
        "policy",
        "dependencies",
        "toolchain",
        "environment"
      ],
      "properties": {
        "workflow": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "config": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dependencies": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "toolchain": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "environment": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "head",
        "base",
        "tree",
        "mode",
        "executor",
        "platform",
        "fingerprints"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "head": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "base": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "tree": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "mode": {
          "enum": [
            "merge",
            "head"
          ]
        },
        "executor": {
          "enum": [
            "act",
            "flox"
          ]
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "fingerprints": {
          "$ref": "#/$defs/fingerprints"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "required",
        "needs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "needs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state",
        "exit_code",
        "duration_ms"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "pending",
            "passed",
            "failed",
            "skipped",
            "cancelled",
            "unsupported",
            "error"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
